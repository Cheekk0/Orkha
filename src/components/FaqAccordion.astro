---
import type { Faq } from '../lib/faqs';
interface Props {
  items: Faq[];
}
const { items } = Astro.props;
---

<div class="divide-y divide-line rounded-xl2 border border-line bg-white">
  {
    items.map((item, i) => (
      <details class="faq-item group" name="faq" open={i === 0}>
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-5 sm:px-6">
          <h3 class="font-display text-base font-semibold text-ink-900 sm:text-lg">{item.q}</h3>
          <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full border border-line text-ink-500 transition-transform duration-200 group-open:rotate-45">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M12 5v14M5 12h14" stroke-linecap="round" />
            </svg>
          </span>
        </summary>
        <div class="px-5 pb-6 sm:px-6">
          <p class="measure text-sm leading-relaxed text-ink-700 sm:text-[0.95rem]">{item.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
</style>
