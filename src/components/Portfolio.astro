---
// Concept homepage work — seven industries, seven brand archetypes.
// These are demonstration designs (fictional businesses), shown to illustrate
// the archetype-driven approach — not real client case studies. Framed as
// concepts on purpose, since the brand is openly pre-first-client.
//
// The showcase is a carousel of the finished concept renders, which live in
// public/portfolio/1.png … 7.png. Each render already carries its own analysis
// panel, so the caption below only restates the essentials for context + alt.

interface Slide {
  src: string;
  company: string;
  industry: string;
  archetype: string;
}

const slides: Slide[] = [
  { src: '/portfolio/1.png', company: 'Helios Solar', industry: 'Solar installer', archetype: 'The Sage · Expert' },
  { src: '/portfolio/2.png', company: 'Northbay Family Dental', industry: 'Dental clinic', archetype: 'The Caregiver' },
  { src: '/portfolio/3.png', company: 'Meridian Detail', industry: 'Auto detailing', archetype: 'The Creator · Craftsman' },
  { src: '/portfolio/4.png', company: 'Delgado Aircon & Ref', industry: 'HVAC contractor', archetype: 'The Everyman · Neighbour' },
  { src: '/portfolio/5.png', company: 'Ironcrest Roofing', industry: 'Roofing', archetype: 'The Hero' },
  { src: '/portfolio/6.png', company: 'Aurelio & Partners', industry: 'Real estate broker', archetype: 'The Ruler · Authority' },
  { src: '/portfolio/7.png', company: 'Casa Verde Design + Build', industry: 'Renovations', archetype: 'The Creator · Craftsman' },
];
const total = slides.length;
---

<section id="work" class="bg-ink-900 py-20 text-cream-50">
  <div class="container-x">
    <div class="max-w-prose" data-reveal>
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-cream-50/50">Selected concept work</p>
      <h2 class="mt-3 font-display text-3xl font-semibold sm:text-4xl">
        Seven industries, seven brand archetypes
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-cream-50/70">
        Every homepage we design starts from a single brand archetype — the psychology drives the copy,
        the palette, the typography and the page structure. These are concept designs, not a template
        with the colours swapped. Swipe through the same craft across seven very different businesses.
      </p>
    </div>

    <!-- ── Carousel ─────────────────────────────────────── -->
    <div
      class="mt-12"
      data-carousel
      role="group"
      aria-roledescription="carousel"
      aria-label="Concept homepage designs"
    >
      <div class="overflow-hidden rounded-xl2 border border-cream-50/10 bg-white/5 shadow-lift">
        <div class="flex transition-transform duration-500 ease-out motion-reduce:transition-none" data-track>
          {
            slides.map((s, i) => (
              <figure
                class="w-full shrink-0"
                role="group"
                aria-roledescription="slide"
                aria-label={`${i + 1} of ${total}: ${s.company}`}
                data-slide
              >
                <img
                  src={s.src}
                  width="1920"
                  height="1080"
                  alt={`${s.company} — concept homepage in the ${s.archetype} archetype, a ${s.industry.toLowerCase()}`}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="block h-auto w-full"
                />
                <figcaption class="flex flex-wrap items-baseline gap-x-3 gap-y-1 border-t border-cream-50/10 px-5 py-4 sm:px-6">
                  <span class="text-[11px] font-semibold uppercase tracking-[0.16em] text-cream-50/40">
                    0{i + 1} / 0{total}
                  </span>
                  <span class="font-display text-lg font-semibold text-cream-50">{s.company}</span>
                  <span class="text-sm text-cream-50/50">· {s.archetype}</span>
                  <span class="ml-auto text-xs uppercase tracking-wide text-cream-50/40">{s.industry}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>

      <!-- controls -->
      <div class="mt-5 flex items-center justify-between gap-4">
        <button
          type="button"
          data-prev
          class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-cream-50/20 text-cream-50 transition hover:bg-cream-50/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream-50/60"
          aria-label="Previous design"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <div class="flex items-center gap-2.5" data-dots role="tablist" aria-label="Choose a design">
          {
            slides.map((s, i) => (
              <button
                type="button"
                data-dot={i}
                role="tab"
                aria-label={s.company}
                aria-selected={i === 0 ? 'true' : 'false'}
                class="h-2.5 w-2.5 rounded-full bg-cream-50/25 transition-colors aria-selected:bg-cream-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream-50/60"
              />
            ))
          }
        </div>

        <button
          type="button"
          data-next
          class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-cream-50/20 text-cream-50 transition hover:bg-cream-50/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cream-50/60"
          aria-label="Next design"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </div>

    <p class="mt-10 max-w-prose text-sm leading-relaxed text-cream-50/50" data-reveal>
      Concept designs for illustration — the businesses above are demonstrations of the approach, not
      past clients. The same thinking goes into every site we build, whether it's the managed system or
      a one-time build.
    </p>
  </div>
</section>

<script>
  // Lightweight, dependency-free carousel. One instance per [data-carousel].
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    if (!track || slides.length === 0) return;

    const count = slides.length;
    let index = 0;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const render = () => {
      track.style.transform = `translateX(-${index * 100}%)`;
      slides.forEach((s, i) => s.setAttribute('aria-hidden', i === index ? 'false' : 'true'));
      dots.forEach((d, i) => d.setAttribute('aria-selected', i === index ? 'true' : 'false'));
    };

    const go = (i: number) => {
      index = (i + count) % count;
      render();
    };

    prev?.addEventListener('click', () => {
      go(index - 1);
      stop();
    });
    next?.addEventListener('click', () => {
      go(index + 1);
      stop();
    });
    dots.forEach((d, i) =>
      d.addEventListener('click', () => {
        go(i);
        stop();
      })
    );

    // Keyboard: arrows move when the carousel has focus within.
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        go(index - 1);
        stop();
      } else if (e.key === 'ArrowRight') {
        go(index + 1);
        stop();
      }
    });

    // Touch swipe.
    let startX = 0;
    let dragging = false;
    track.addEventListener(
      'touchstart',
      (e) => {
        startX = e.touches[0].clientX;
        dragging = true;
      },
      { passive: true }
    );
    track.addEventListener(
      'touchend',
      (e) => {
        if (!dragging) return;
        dragging = false;
        const dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 40) {
          go(index + (dx < 0 ? 1 : -1));
          stop();
        }
      },
      { passive: true }
    );

    // Autoplay — off for reduced-motion; pauses on hover/focus.
    let timer: number | undefined;
    const start = () => {
      if (reduce) return;
      stop();
      timer = window.setInterval(() => go(index + 1), 6000);
    };
    function stop() {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    }
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);

    render();
    start();
  });
</script>
