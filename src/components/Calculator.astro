---
// Revenue-opportunity estimator. Conversation-starter, NOT a guarantee.
// Formula + ranges are fixed by Brief.MD and implemented exactly below.
// "Leads" is deliberately avoided in labels per Constraints §5 (uses "inquiries").
---

<div class="card overflow-hidden" id="calc" data-reveal>
  <div class="grid lg:grid-cols-[1.05fr_1fr]">
    <!-- ── Inputs ─────────────────────────────────────── -->
    <div class="border-b border-line p-6 sm:p-8 lg:border-b-0 lg:border-r">
      <p class="eyebrow">The math, on your numbers</p>
      <h3 class="mt-3 font-display text-2xl font-semibold text-ink-900">
        What might slip through in a month?
      </h3>
      <p class="mt-2 text-sm leading-relaxed text-ink-600">
        Enter a few numbers about your business. This is an illustrative estimate, not a
        prediction — read it as a starting point for a conversation.
      </p>

      <div class="mt-7 space-y-7">
        <!-- 1. customer value -->
        <div>
          <div class="flex items-baseline justify-between gap-3">
            <label for="c-value" class="text-sm font-semibold text-ink-800">
              Average value of one new customer
            </label>
            <output id="out-value" class="tabular text-sm font-semibold text-ink-700">₱10,000</output>
          </div>
          <input id="c-value" type="range" min="1000" max="500000" step="2000" value="10000"
            class="range mt-3" aria-describedby="hint-value" />
          <p id="hint-value" class="mt-1.5 text-xs text-ink-500">
            What one new client is typically worth to you.
          </p>
        </div>

        <!-- 2. daily inquiries -->
        <div>
          <div class="flex items-baseline justify-between gap-3">
            <label for="c-leads" class="text-sm font-semibold text-ink-800">
              Inquiries you get per day
            </label>
            <output id="out-leads" class="tabular text-sm font-semibold text-ink-700">2</output>
          </div>
          <input id="c-leads" type="range" min="1" max="20" step="1" value="2" class="range mt-3" />
          <p class="mt-1.5 text-xs text-ink-500">
            Messages, DMs and form fills — everyone who reaches out. Assumes a 30-day month.
          </p>
        </div>

        <!-- 3. close rate -->
        <div>
          <div class="flex items-baseline justify-between gap-3">
            <label for="c-close" class="text-sm font-semibold text-ink-800">
              Close rate on inquiries you actually talk to
            </label>
            <output id="out-close" class="tabular text-sm font-semibold text-ink-700">20%</output>
          </div>
          <input id="c-close" type="range" min="5" max="60" step="1" value="20" class="range mt-3" />
          <p class="mt-1.5 text-xs text-ink-500">Industry default ~20%.</p>
        </div>

        <!-- 4 + 5. toggles -->
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <span class="mb-2 block text-sm font-semibold text-ink-800">Do you have a website?</span>
            <div class="toggle" role="group" aria-label="Do you have a website?">
              <button type="button" data-toggle="website" data-val="1" class="t-btn">Yes</button>
              <button type="button" data-toggle="website" data-val="0" class="t-btn is-on">No</button>
            </div>
          </div>
          <div>
            <span class="mb-2 block text-sm font-semibold text-ink-800">Reply within minutes, 24/7?</span>
            <div class="toggle" role="group" aria-label="Do you respond within minutes, 24/7?">
              <button type="button" data-toggle="speed" data-val="1" class="t-btn">Yes</button>
              <button type="button" data-toggle="speed" data-val="0" class="t-btn is-on">No</button>
            </div>
          </div>
        </div>

        <!-- advanced -->
        <details class="rounded-xl border border-line bg-paper/60">
          <summary class="cursor-pointer select-none px-4 py-3 text-sm font-semibold text-ink-700">
            Adjust assumptions
          </summary>
          <div class="space-y-6 border-t border-line px-4 py-5">
            <p class="text-xs leading-relaxed text-ink-500">
              These two multipliers are <strong>assumptions</strong>, not measured facts. Tune them
              to be as conservative as you like.
            </p>
            <div>
              <div class="flex items-baseline justify-between gap-3">
                <label for="c-web" class="text-xs font-semibold text-ink-700">
                  Extra customers a discoverable SEO website could bring
                </label>
                <output id="out-web" class="tabular text-xs font-semibold text-ink-700">30%</output>
              </div>
              <input id="c-web" type="range" min="0" max="60" step="1" value="30" class="range mt-2.5" />
            </div>
            <div>
              <div class="flex items-baseline justify-between gap-3">
                <label for="c-speed" class="text-xs font-semibold text-ink-700">
                  Share of slow / after-hours inquiries instant AI recovers
                </label>
                <output id="out-speed" class="tabular text-xs font-semibold text-ink-700">30%</output>
              </div>
              <input id="c-speed" type="range" min="0" max="60" step="1" value="30" class="range mt-2.5" />
            </div>
          </div>
        </details>
      </div>
    </div>

    <!-- ── Result ─────────────────────────────────────── -->
    <div class="flex flex-col bg-ink-900 p-6 text-cream-50 sm:p-8">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-cream-50/50">
        Estimated revenue opportunity per year
      </p>
      <p id="r-annual" class="tabular mt-2 font-display text-[2.75rem] font-semibold leading-none sm:text-6xl">
        ₱0
      </p>
      <p class="mt-3 text-sm text-cream-50/70">
        <span id="r-monthly" class="tabular font-semibold text-cream-50">₱0</span> per month
      </p>

      <div class="mt-7 space-y-3">
        <div class="rounded-xl bg-white/5 p-4">
          <div class="flex items-center justify-between gap-3">
            <span class="text-sm text-cream-50/80">Being invisible online (no website)</span>
            <span id="r-web" class="tabular shrink-0 text-sm font-semibold">₱0/mo</span>
          </div>
        </div>
        <div class="rounded-xl bg-white/5 p-4">
          <div class="flex items-center justify-between gap-3">
            <span class="text-sm text-cream-50/80">Slow / after-hours replies (no AI receptionist)</span>
            <span id="r-ai" class="tabular shrink-0 text-sm font-semibold">₱0/mo</span>
          </div>
        </div>
      </div>

      <a href="/contact/" class="btn-accent mt-7 w-full">See how we'd capture this for you</a>

      <p class="mt-5 text-[11px] leading-relaxed text-cream-50/60">
        <strong class="font-semibold text-cream-50/70">This is a theoretical, illustrative estimate only.</strong>
        It is built from published third-party research on lead-response times and online-buying
        behavior — much of it from software vendors, not controlled experiments — and applies broad
        industry averages to the numbers you entered. It assumes those averages apply to your specific
        business, which may not be true. It is NOT a prediction, guarantee, or promise of results.
        Actual outcomes depend on your market, offer, pricing, competition, and execution. Figures are
        for discussion purposes only.
      </p>
    </div>
  </div>
</div>

<style>
  .range {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 6px;
    border-radius: 9999px;
    background: #e7e3d8;
    outline-offset: 4px;
  }
  .range::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 22px;
    height: 22px;
    border-radius: 9999px;
    background: #1b3c53;
    border: 3px solid #fbfaf6;
    box-shadow: 0 2px 6px rgba(19, 43, 60, 0.35);
    cursor: pointer;
  }
  .range::-moz-range-thumb {
    width: 22px;
    height: 22px;
    border-radius: 9999px;
    background: #1b3c53;
    border: 3px solid #fbfaf6;
    box-shadow: 0 2px 6px rgba(19, 43, 60, 0.35);
    cursor: pointer;
  }
  .toggle {
    display: inline-flex;
    width: 100%;
    padding: 3px;
    gap: 3px;
    border-radius: 9999px;
    background: #eef0e9;
    border: 1px solid #e7e3d8;
  }
  .t-btn {
    flex: 1;
    border-radius: 9999px;
    padding: 0.5rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #456882;
    transition: all 0.18s ease;
  }
  .t-btn.is-on {
    background: #1b3c53;
    color: #fdf2d4;
    box-shadow: 0 2px 6px rgba(19, 43, 60, 0.25);
  }
</style>

<script>
  (() => {
    const $ = (id: string) => document.getElementById(id) as HTMLElement | null;
    const calc = $('calc');
    if (!calc) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const peso = new Intl.NumberFormat('en-PH', { maximumFractionDigits: 0 });
    const fmt = (n: number) => '₱' + peso.format(Math.round(n));

    // state
    const state = {
      V: 10000,
      L: 60, // 2/day × 30-day month
      C: 0.2,
      website: 0, // 0 = no website
      speed: 0, // 0 = not instant
      rWeb: 0.3,
      rSpeed: 0.3,
    };

    // input refs
    const cValue = $('c-value') as HTMLInputElement;
    const cLeads = $('c-leads') as HTMLInputElement;
    const cClose = $('c-close') as HTMLInputElement;
    const cWeb = $('c-web') as HTMLInputElement;
    const cSpeed = $('c-speed') as HTMLInputElement;

    // count-up animation per output element
    const anims = new WeakMap<HTMLElement, number>();
    const setNum = (el: HTMLElement | null, value: number, suffix = '') => {
      if (!el) return;
      const prev = Number(el.dataset.raw || '0');
      el.dataset.raw = String(value);
      if (reduce || prev === value) {
        el.textContent = fmt(value) + suffix;
        return;
      }
      const start = performance.now();
      const dur = 500;
      if (anims.has(el)) cancelAnimationFrame(anims.get(el)!);
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = fmt(prev + (value - prev) * eased) + suffix;
        if (t < 1) anims.set(el, requestAnimationFrame(step));
      };
      anims.set(el, requestAnimationFrame(step));
    };

    const compute = () => {
      const mWeb = state.website ? 0 : state.L * state.rWeb * state.C * state.V;
      const mAi = state.speed ? 0 : state.L * state.rSpeed * state.C * state.V;
      const monthly = mWeb + mAi;
      const annual = monthly * 12;

      setNum($('r-annual'), annual);
      setNum($('r-monthly'), monthly);

      // breakdown rows: show "already capturing" when toggle = Yes
      const rWeb = $('r-web');
      const rAi = $('r-ai');
      if (state.website) {
        if (rWeb) { rWeb.textContent = "₱0 — already capturing ✔"; rWeb.dataset.raw = '0'; }
      } else {
        setNum(rWeb, mWeb, '/mo');
      }
      if (state.speed) {
        if (rAi) { rAi.textContent = "₱0 — already capturing ✔"; rAi.dataset.raw = '0'; }
      } else {
        setNum(rAi, mAi, '/mo');
      }
    };

    // wire ranges
    cValue?.addEventListener('input', () => {
      state.V = +cValue.value;
      const o = $('out-value'); if (o) o.textContent = fmt(state.V);
      compute();
    });
    cLeads?.addEventListener('input', () => {
      const daily = +cLeads.value;
      state.L = daily * 30; // convert to a 30-day month for the formula
      const o = $('out-leads'); if (o) o.textContent = String(daily);
      compute();
    });
    cClose?.addEventListener('input', () => {
      state.C = +cClose.value / 100;
      const o = $('out-close'); if (o) o.textContent = cClose.value + '%';
      compute();
    });
    cWeb?.addEventListener('input', () => {
      state.rWeb = +cWeb.value / 100;
      const o = $('out-web'); if (o) o.textContent = cWeb.value + '%';
      compute();
    });
    cSpeed?.addEventListener('input', () => {
      state.rSpeed = +cSpeed.value / 100;
      const o = $('out-speed'); if (o) o.textContent = cSpeed.value + '%';
      compute();
    });

    // wire toggles
    calc.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const group = btn.dataset.toggle as 'website' | 'speed';
        const val = +(btn.dataset.val || '0');
        state[group] = val;
        calc
          .querySelectorAll<HTMLButtonElement>(`[data-toggle="${group}"]`)
          .forEach((b) => b.classList.toggle('is-on', b === btn));
        compute();
      });
    });

    compute();
  })();
</script>
