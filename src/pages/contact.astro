---
import Base from '../layouts/Base.astro';
import GhlForm from '../components/GhlForm.astro';
import { SITE_URL, BUSINESS } from '../lib/site';

const title = 'Contact Orkha | Book a Call';
const description =
  'Tell us about your business and book a call. See how fast we respond — that\'s the system you\'d be getting, working on you.';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL + '/' },
    { '@type': 'ListItem', position: 2, name: 'Contact', item: SITE_URL + '/contact/' },
  ],
};

const a = BUSINESS.address;
const methods = [
  {
    label: 'Email',
    value: BUSINESS.email,
    href: `mailto:${BUSINESS.email}`,
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  },
  {
    label: 'Phone',
    value: BUSINESS.phoneDisplay,
    href: `tel:${BUSINESS.phoneHref}`,
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h4l2 5-3 2a12 12 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  },
  {
    label: 'Facebook (live demo)',
    value: 'Message our page',
    href: BUSINESS.facebook,
    icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M14 9V7a2 2 0 0 1 2-2h2V2h-3a4 4 0 0 0-4 4v3H8v3h3v9h3v-9h3l1-3h-4Z" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  },
];
---

<Base title={title} description={description} path="/contact/" schema={[breadcrumb]}>
  <section class="container-x pt-16 pb-6">
    <div class="max-w-3xl" data-reveal>
      <p class="eyebrow">Contact</p>
      <h1 class="mt-4 font-display text-4xl font-semibold text-ink-900 sm:text-5xl">
        Let's talk about the customers you're missing
      </h1>
      <p class="mt-5 max-w-prose text-lg leading-relaxed text-ink-600">
        Tell us a little about your business and book a call. Notice how quickly we get back to you —
        that responsiveness is the system you'd be getting, running on us.
      </p>
    </div>
  </section>

  <section class="container-x pb-16">
    <div class="grid items-start gap-10 lg:grid-cols-[1fr_1.15fr]">
      <!-- details -->
      <div class="space-y-8" data-reveal>
        <div class="grid gap-3">
          {
            methods.map((m) => (
              <a
                href={m.href}
                target={m.href.startsWith('http') ? '_blank' : undefined}
                rel={m.href.startsWith('http') ? 'noopener' : undefined}
                class="card flex items-center gap-4 p-5 no-underline transition-shadow hover:shadow-lift"
              >
                <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-ink-800/8 text-ink-800">
                  <Fragment set:html={m.icon} />
                </span>
                <span>
                  <span class="block text-xs font-semibold uppercase tracking-wide text-ink-500">{m.label}</span>
                  <span class="block text-sm font-medium text-ink-900">{m.value}</span>
                </span>
              </a>
            ))
          }
        </div>

        <div class="card p-6">
          <h2 class="text-xs font-semibold uppercase tracking-[0.16em] text-ink-500">Where we are</h2>
          <address class="mt-3 not-italic text-sm leading-relaxed text-ink-700">
            {a.street}<br />
            {a.barangay}, {a.city}, {a.region}<br />
            {a.country}
          </address>
          <p class="mt-3 text-sm text-ink-500">{BUSINESS.serviceArea}</p>
        </div>
      </div>

      <!-- form -->
      <div>
        <GhlForm />
      </div>
    </div>
  </section>
</Base>
