---
import Base from '../layouts/Base.astro';

const title = 'Page not found | Orkha';
const description = 'The page you were looking for could not be found.';
---

<Base title={title} description={description} path="/404/" noindex>
  <section class="container-x flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <p class="font-display text-7xl font-semibold text-ink-800/20 tabular">404</p>
    <h1 class="mt-4 font-display text-3xl font-semibold text-ink-900 sm:text-4xl">
      This page slipped through the cracks
    </h1>
    <p class="mt-4 max-w-md text-base leading-relaxed text-ink-600">
      Fitting, given what we do — but let's get you back on track. The page you were after isn't here.
    </p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="btn-primary">Back to home</a>
      <a href="/contact/" class="btn-ghost">Contact us</a>
    </div>
  </section>
</Base>
