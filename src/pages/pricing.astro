---
import Base from '../layouts/Base.astro';
import GhlForm from '../components/GhlForm.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE_URL, TIMEFRAME, ONE_TIME } from '../lib/site';

const title = 'Pricing & Plans | Orkha';
const description =
  'One system, one monthly price — website, SEO, and AI inquiry capture, fully managed. Founding-client rates available now, month-to-month with no lock-in.';

const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL + '/' },
    { '@type': 'ListItem', position: 2, name: 'Pricing', item: SITE_URL + '/pricing/' },
  ],
};

const included = [
  'Fully managed, fast static website — a ₱15,000 build, free with the service',
  'Monthly SEO + GEO (incl. directory & publication outreach)',
  'AI that answers & qualifies Instagram DMs, Facebook Messenger and web forms 24/7',
  'Every conversation routed to a Google Sheet you own',
  'Google Business Profile setup & optimisation',
  '10 free NFC review cards — extra anytime at ₱20 each, a convenience, not an add-on',
  'Hosting, maintenance & updates',
  `Fully live in ${TIMEFRAME}`,
];

const futureAddons = [
  { name: 'Automated SMS reminders', note: 'future rate ≈ ₱2,000 / mo' },
  { name: 'Physical merch & product handling', note: 'future rate ≈ ₱500 / mo' },
  { name: 'Multi-branch (per branch above 3)', note: 'future rate ≈ ₱2,000 / mo' },
  { name: 'Reactivation campaigns', note: 'pricing TBA' },
  { name: 'More inquiry channels — WhatsApp, email, SMS', note: 'pricing TBA' },
  { name: 'Direct calendar booking', note: 'pricing TBA' },
  { name: 'Paid ad management (Meta / Google)', note: 'pricing TBA' },
];

const oneTimeIncluded = [
  'Custom-designed, fast static website — no cookie-cutter template',
  `Delivered in ${ONE_TIME.timeframe}`,
  'Hosting handled for you',
  `${ONE_TIME.revisions} rounds of revisions after delivery`,
  'You keep everything — the site is yours to own',
  'Domain registered in your name — you cover the domain cost',
];

const compare = [
  { row: 'Monthly rate', now: '₱15,000 (until +50% customers captured)', later: '₱20,000' },
  { row: 'Website (₱15,000 build)', now: 'Free with the service', later: 'Free with the service' },
  { row: 'Founding batch', now: 'First 5 clients only', later: 'Standard pricing' },
  { row: 'Future Add-Ons after month 6', now: 'Free, forever, at your locked rate', later: 'Paid, item by item' },
  { row: 'Lock-in', now: 'None — month-to-month', later: 'None — month-to-month' },
];
---

<Base title={title} description={description} path="/pricing/" schema={[breadcrumb]}>
  <section class="container-x pt-14 pb-6">
    <div class="mx-auto max-w-3xl text-center" data-reveal>
      <p class="eyebrow justify-center">Pricing</p>
      <h1 class="mt-4 font-display text-4xl font-semibold text-ink-900 sm:text-5xl">
        One system, one monthly price
      </h1>
      <!-- Recap for anyone landing here directly -->
      <p class="mx-auto mt-5 max-w-prose text-lg leading-relaxed text-ink-600">
        Orkha builds and runs an always-on system for appointment-driven service businesses: a fast,
        findable website, continuous SEO and GEO, and AI that answers and qualifies your messages
        24/7 — every conversation logged in a Google Sheet you own. Not a website you buy once; a
        working system you rent, maintained every day.
      </p>
    </div>
  </section>

  <!-- ── Plan cards ───────────────────────────────────── -->
  <section class="container-x pb-4">
    <div class="grid gap-6 lg:grid-cols-2">
      <!-- Founding -->
      <div class="relative overflow-hidden rounded-xl2 border-2 border-ink-800 bg-white p-8 shadow-lift" data-reveal>
        <span class="absolute right-6 top-6 rounded-full bg-cream-100 px-3 py-1 text-xs font-semibold text-ink-900">
          Pilot phase · 25% off
        </span>
        <p class="eyebrow">Founding batch</p>
        <div class="mt-4 flex items-end gap-2">
          <span class="font-display text-5xl font-semibold text-ink-900 tabular">₱15,000</span>
          <span class="mb-1.5 text-sm text-ink-500">/ month</span>
        </div>
        <p class="mt-2 text-sm text-ink-600">
          For the service — the always-on AI, SEO and inquiry capture. Then ₱20,000/month, but only
          once we've grown the <strong>potential customers we capture for you by 50%</strong> over the
          past 3 months. Offered to the first <strong>5 clients</strong> only, while we're in our
          pilot phase.
        </p>
        <p class="mt-4 rounded-xl bg-cream-100 px-4 py-3 text-sm font-medium leading-relaxed text-ink-800">
          <strong>Your website, free.</strong> The website itself is a separate ₱15,000 one-time
          build — but take the monthly service and we throw it in at no cost.
        </p>
        <ul class="mt-6 space-y-2.5">
          {
            included.map((li) => (
              <li class="flex items-start gap-2.5 text-sm text-ink-700">
                <svg class="mt-0.5 shrink-0 text-ink-600" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {li}
              </li>
            ))
          }
        </ul>
        <a href="/contact/" class="btn-primary mt-8 w-full">Claim a founding slot</a>
        <p class="mt-4 text-xs leading-relaxed text-ink-500">
          Payable in two installments each month — one at sign-on, the second after two weeks. Stay
          past month 6 and every feature we launch afterward is included free, forever, at your
          locked rate.
        </p>
      </div>

      <!-- Standard -->
      <div class="rounded-xl2 border border-line bg-paper p-8" data-reveal>
        <p class="eyebrow">Standard</p>
        <div class="mt-4 flex items-end gap-2">
          <span class="font-display text-5xl font-semibold text-ink-800 tabular">₱20,000</span>
          <span class="mb-1.5 text-sm text-ink-500">/ month</span>
        </div>
        <p class="mt-2 text-sm text-ink-600">
          Ongoing, month-to-month, no long-term lock-in. The full system, maintained — this is the
          rate once the founding batch closes, or once a founding client hits the 50% increase in
          potential customers captured that graduates them off the founding rate.
        </p>
        <ul class="mt-6 space-y-2.5">
          {
            included.map((li) => (
              <li class="flex items-start gap-2.5 text-sm text-ink-700">
                <svg class="mt-0.5 shrink-0 text-ink-500" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {li}
              </li>
            ))
          }
        </ul>
        <a href="/contact/" class="btn-ghost mt-8 w-full">Book a call</a>
        <p class="mt-4 text-xs leading-relaxed text-ink-500">
          Same system, same accountability. The founding rate simply prices in the fact that we're
          new — later clients pay this.
        </p>
      </div>
    </div>

    <p class="mt-6 text-center text-sm text-ink-500">
      Every plan is month-to-month with no lock-in — you can leave the moment it stops earning its keep.
    </p>
  </section>

  <!-- ── One-time website builds ──────────────────────── -->
  <section class="container-x py-10">
    <div class="rounded-xl2 border border-line bg-paper p-8 sm:p-10" data-reveal>
      <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
        <div>
          <p class="eyebrow">Prefer to own it outright?</p>
          <h2 class="mt-3 font-display text-3xl font-semibold text-ink-900">One-time website builds</h2>
          <div class="mt-5 flex items-end gap-2">
            <span class="font-display text-5xl font-semibold text-ink-900 tabular">{ONE_TIME.price}</span>
            <span class="mb-1.5 text-sm text-ink-500">one-time</span>
          </div>
          <p class="mt-4 text-base leading-relaxed text-ink-600">
            Not everyone needs the always-on system. If you just want a fast, well-built website you own
            outright, we'll design and build it as a one-time project — no monthly fee, no lock-in.
          </p>
          <div class="mt-6 rounded-xl border border-line bg-white p-4">
            <p class="text-sm font-semibold text-ink-900">How payment works</p>
            <p class="mt-1 text-sm leading-relaxed text-ink-700">
              {ONE_TIME.payment} — half to get started, the other half once the site is done and you're
              happy with it.
            </p>
          </div>
          <a href="/contact/" class="btn-primary mt-6">Enquire about a one-time build</a>
        </div>

        <div>
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-ink-500">What's included</p>
          <ul class="mt-4 space-y-2.5">
            {
              oneTimeIncluded.map((li) => (
                <li class="flex items-start gap-2.5 text-sm text-ink-700">
                  <svg class="mt-0.5 shrink-0 text-ink-600" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {li}
                </li>
              ))
            }
          </ul>
          <p class="mt-6 rounded-xl bg-cream-100/60 p-4 text-sm font-medium leading-relaxed text-ink-800">
            Taking the monthly service instead? This ₱15,000 build is <strong>free</strong> — the
            website comes included the moment you're on a plan.
          </p>
          <p class="mt-4 text-xs leading-relaxed text-ink-500">
            A one-time build is the website only — it doesn't include the always-on AI, ongoing SEO/GEO,
            or the inquiry system. Want those too? The managed plan above covers everything, maintained
            every day — and the website comes free with it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Future Add-Ons ───────────────────────────────── -->
  <section class="container-x py-14">
    <div class="grid gap-8 lg:grid-cols-[1fr_1.2fr]">
      <div data-reveal>
        <p class="eyebrow">Coming next</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-ink-900">Future Add-Ons</h2>
        <p class="mt-3 text-base leading-relaxed text-ink-600">
          The base system stays deliberately narrow: the website, the AI, and the Google Sheet
          handoff, plus your 10 free NFC cards. Nothing below is sold separately today — it's what we
          build next.
        </p>
        <p class="mt-4 rounded-xl bg-cream-100/60 p-4 text-sm font-medium leading-relaxed text-ink-800">
          Stay past month 6 as a founding client and every one of these is yours free, forever, at
          your locked rate — the moment it ships. Later clients pay for each one individually.
        </p>
      </div>
      <div class="card divide-y divide-line" data-reveal>
        {
          futureAddons.map((a) => (
            <div class="flex items-center justify-between gap-4 px-6 py-5">
              <span class="text-sm font-medium text-ink-800">{a.name}</span>
              <span class="tabular shrink-0 text-xs font-semibold text-ink-500">{a.note}</span>
            </div>
          ))
        }
        <div class="px-6 py-5 text-xs leading-relaxed text-ink-500">
          Instagram DMs and Facebook Messenger are included in every plan today — WhatsApp, email and
          SMS as inquiry channels are on this list instead. When paid ad management launches, ad
          spend is never included — you pay your own ad spend on top of the service fee, always.
        </div>
      </div>
    </div>
  </section>

  <!-- ── Now vs later ─────────────────────────────────── -->
  <section class="container-x py-6">
    <div class="max-w-prose" data-reveal>
      <p class="eyebrow">Now vs later</p>
      <h2 class="mt-3 font-display text-3xl font-semibold text-ink-900">Why being early is the discount</h2>
      <p class="mt-3 text-base leading-relaxed text-ink-600">
        The founding batch isn't a fake countdown — it's a real cap of 5 clients. Here's exactly
        what the timing changes.
      </p>
    </div>

    <div class="mt-8 overflow-x-auto" data-reveal>
      <table class="w-full min-w-[560px] border-collapse overflow-hidden rounded-xl2 border border-line bg-white text-left text-sm">
        <thead>
          <tr class="bg-paper">
            <th class="border-b border-line px-5 py-4 font-semibold text-ink-500"></th>
            <th class="border-b border-line px-5 py-4 font-display text-base font-semibold text-ink-900">
              Founding client (now)
            </th>
            <th class="border-b border-line px-5 py-4 font-display text-base font-semibold text-ink-500">
              Later
            </th>
          </tr>
        </thead>
        <tbody>
          {
            compare.map((c) => (
              <tr>
                <td class="border-b border-line/70 px-5 py-4 font-medium text-ink-700">{c.row}</td>
                <td class="border-b border-line/70 px-5 py-4 font-semibold text-ink-900">{c.now}</td>
                <td class="border-b border-line/70 px-5 py-4 text-ink-500">{c.later}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="mt-6 max-w-prose text-sm leading-relaxed text-ink-500">
      Prices reflect the full managed system and are shown as written — no hidden tiers. If your
      situation is unusual, talk to us; there's room to work something out.
    </p>
  </section>

  <!-- ── Form ─────────────────────────────────────────── -->
  <section class="container-x py-14">
    <div class="grid items-start gap-10 lg:grid-cols-[1fr_1.1fr]">
      <div data-reveal>
        <p class="eyebrow">Ready when you are</p>
        <h2 class="mt-3 font-display text-3xl font-semibold text-ink-900 sm:text-4xl">
          Lock in the founding rate
        </h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-600">
          Tell us about your business and we'll walk you through exactly how the system would work —
          and how fast we'd have it live. Watch how quickly we reply; that's the product.
        </p>
      </div>
      <div data-reveal>
        <GhlForm />
      </div>
    </div>
  </section>

  <CtaBand
    heading="Still deciding? Watch it work first."
    sub="Message our own Facebook page and let the AI qualify you in real time — the exact system you'd be paying for, running on us."
  />
</Base>
